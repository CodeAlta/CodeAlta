{
  "mcpServers": {
    "chrome-devtools": {
      "command": "fnm",
      "args": [
        "exec",
        "--using=default",
        "cmd",
        "/c",
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--browserUrl",
        "http://127.0.0.1:9222",
        "--no-usage-statistics",
        "--no-performance-crux"
      ]
    }
  }
}
