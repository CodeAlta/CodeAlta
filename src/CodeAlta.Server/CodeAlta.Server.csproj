<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>

    <PackAsTool>true</PackAsTool>
    <RootNamespace>CodeAlta.Server</RootNamespace>
    <PackageId>CodeAlta.Server</PackageId>
    <AssemblyName>altaserver</AssemblyName>
    <ToolCommandName>altaserver</ToolCommandName>

    <!-- Not Native AOT (doc/fleet/server.md, stack): the OpenID Connect authentication it will need is not supported
         under AOT. Contracts are source-generated all the same. -->
    <RuntimeIdentifiers>linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64;win-x64;win-arm64;osx-arm64;osx-x64</RuntimeIdentifiers>
    <PublishSelfContained>false</PublishSelfContained>
    <!-- Precompiled code in each runtime's package: the application starts without compiling its methods first. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationIcon>..\..\img\alta.ico</ApplicationIcon>
    <Description>CodeAlta Server: the coordinator of a CodeAlta fleet. It knows the people, devices and machines of an organization, which are online, and the facts of the sessions they publish; it runs no agent and reads no session content. Start it with altaserver run.</Description>
    <PackageTags>agentic;ai;coding-agent;fleet;coordinator;server</PackageTags>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <PackageIcon>CodeAlta.png</PackageIcon>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageProjectUrl>https://github.com/CodeAlta/CodeAlta</PackageProjectUrl>
    <PackageLicenseExpression>BSD-2-Clause</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../img/CodeAlta.png" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)../../readme.md" Pack="true" PackagePath="/" />
    <EmbeddedResource Include="Storage/Sqlite/Migrations/*.sql" LogicalName="CodeAlta.Server.Storage.Sqlite.Migrations.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MinVer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Its own traces, metrics and logs, and ASP.NET Core's, over OTLP when a collector is named (doc/fleet/observability.md). -->
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="XenoAtom.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <!-- The server references the protocol only, never the agent runtime: ArchitectureGuardrailTests checks it. -->
    <ProjectReference Include="..\CodeAlta.Fleet.Protocol\CodeAlta.Fleet.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The OTLP export shared with altanode, as source: the server references no CodeAlta library but the protocol. -->
    <Compile Include="..\Shared\FleetTelemetry\FleetOtlpPipeline.cs" Link="Telemetry\FleetOtlpPipeline.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CodeAlta.Server.Tests" />
  </ItemGroup>
</Project>
