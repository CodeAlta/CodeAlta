<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../img/alta.ico</ApplicationIcon>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CodeAlta</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <PackageId>CodeAlta</PackageId>
    <AssemblyName>alta</AssemblyName>
    <ToolCommandName>alta</ToolCommandName>
    <!-- One framework-dependent tool package per runtime, like CodeAlta.Tui: a single package for every
         runtime carries the native libraries of all of them (230 MB in 1.0.0). These are the runtimes
         NeoAstra has a native library for. -->
    <RuntimeIdentifiers>win-x64;win-arm64;osx-x64;osx-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
    <PublishSelfContained>false</PublishSelfContained>
    <PublishAot>false</PublishAot>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PackageTags>agentic;ai;coding-agent;llm;mcp;desktop</PackageTags>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <PackageIcon>CodeAlta.png</PackageIcon>
    <PackageLicenseExpression>BSD-2-Clause</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/CodeAlta/CodeAlta</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <Description>CodeAlta Desktop: a desktop workspace for agentic AI coding on your local projects, with session tabs you can split, a file editor, model providers, MCP servers, skills and plugins. Start it with the alta command.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- The package shows the repository readme, like CodeAlta.Tui; README.md in this folder is for developers. -->
    <None Include="$(MSBuildThisFileDirectory)../../readme.md" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)../../img/CodeAlta.png" Pack="true" PackagePath="/" />
    <!-- The window's own icon (Alt+Tab, task switcher): the executable's icon resource does not reach the native window. -->
    <!-- These are read beside the application: Pack="false" keeps the copies NuGet adds for content files out of each package. -->
    <Content Include="../../img/alta.ico" Link="alta.ico" CopyToOutputDirectory="PreserveNewest" Pack="false" />
    <!-- The same icon for the other desktops: the window, tray and launcher on Linux, the menu bar item, the
         Dock and the application bundle on macOS, where the icon family keeps the margin of the system's
         icon grid. img/make-icons.py derives them from CodeAlta.png. -->
    <Content Include="../../img/alta.png" Link="alta.png" CopyToOutputDirectory="PreserveNewest" Pack="false" />
    <Content Include="../../img/alta-tray.png" Link="alta-tray.png" CopyToOutputDirectory="PreserveNewest" Pack="false" />
    <Content Include="../../img/alta.icns" Link="alta.icns" CopyToOutputDirectory="PreserveNewest" Pack="false" />
    <!-- The user guide of the site, for the agents: they answer questions about CodeAlta from it and guide the
         user in the window. Its pages, and the pictures of the desktop application the pages show. -->
    <Content Include="../../site/docs/**/*.md" Link="content/user-guide/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Pack="false" />
    <Content Include="../../site/img/alta-desktop-*.webp" Link="content/user-guide/img/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Pack="false" />
    <!-- The page imports the logo from outside its folder: without this, changing it does not rebuild the page. -->
    <NeoAstraFrontendInput Include="../../img/CodeAlta.svg" />
    <PackageReference Include="NeoAstra" />
    <!-- The MCP server other applications drive the window through: the official C# SDK, over HTTP. It brings
         the ASP.NET Core shared framework, which the .NET SDK a tool is installed with has. -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <InternalsVisibleTo Include="CodeAlta.Desktop.Tests" />
    <ProjectReference Include="../CodeAlta.Catalog/CodeAlta.Catalog.csproj" />
    <ProjectReference Include="../CodeAlta.Agent/CodeAlta.Agent.csproj" />
    <ProjectReference Include="../CodeAlta.Hosting/CodeAlta.Hosting.csproj" />
    <ProjectReference Include="../CodeAlta.Plugin.Mcp/CodeAlta.Plugin.Mcp.csproj" />
    <ProjectReference Include="../CodeAlta.Plugin.Git/CodeAlta.Plugin.Git.csproj" />
    <ProjectReference Include="../CodeAlta.Plugin.Jira/CodeAlta.Plugin.Jira.csproj" />
    <ProjectReference Include="../CodeAlta.Plugin.Statistics/CodeAlta.Plugin.Statistics.csproj" />
    <ProjectReference Include="../CodeAlta.LiveTool/CodeAlta.LiveTool.csproj" />
    <ProjectReference Include="../CodeAlta.Orchestration/CodeAlta.Orchestration.csproj" />
    <!-- A source plugin is compiled once for both applications and can reference the terminal UI. Its
         assemblies are here so that such a plugin loads; the desktop never shows a terminal visual. -->
    <ProjectReference Include="../CodeAlta.Plugins.Tui/CodeAlta.Plugins.Tui.csproj" />
    <PackageReference Include="XenoAtom.Terminal.UI" />
    <PackageReference Include="XenoAtom.Terminal.UI.Extensions.CodeEditor.TextMateSharp" />
    <PackageReference Include="XenoAtom.Terminal.UI.Extensions.Markdown" />
    <PackageReference Include="XenoAtom.Terminal.UI.Extensions.Screenshot" />
    <PackageReference Include="XenoAtom.Terminal.UI.Graphics" />
  </ItemGroup>
  <!-- The per-runtime builds of a pack run in parallel, and the page is the same for all of them. Only the
       build without a runtime restores and builds it: a per-runtime build takes frontend/dist as it is and
       keeps its generated contracts in its own folder, so that the builds share no file they write. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <NeoAstraPrebuiltAssets>true</NeoAstraPrebuiltAssets>
    <NeoAstraPrebuiltAssetDirectory>$(MSBuildProjectDirectory)/frontend/dist</NeoAstraPrebuiltAssetDirectory>
    <NeoAstraStageFrontendClient>false</NeoAstraStageFrontendClient>
    <NeoRpcIntermediateOutputPath>$(MSBuildProjectExtensionsPath)neoastra/$(RuntimeIdentifier)</NeoRpcIntermediateOutputPath>
    <NeoRpcTypeScriptOutput>$(NeoRpcIntermediateOutputPath)/neoastra.ts</NeoRpcTypeScriptOutput>
    <NeoRpcManifestOutput>$(NeoRpcIntermediateOutputPath)/neoastra.manifest.json</NeoRpcManifestOutput>
    <NeoRpcSchemaOutput>$(NeoRpcIntermediateOutputPath)/neoastra.schema.json</NeoRpcSchemaOutput>
  </PropertyGroup>
  <Target Name="CodeAltaBuildFrontendOnce" BeforeTargets="NeoAstraComputeFrontendFingerprint" Condition="'$(RuntimeIdentifier)' != ''">
    <!-- MSBuild runs a target once for a project and its properties: the builds that ask for it wait for the first one. -->
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="NeoAstraPrepareFrontend" RemoveProperties="RuntimeIdentifier" />
  </Target>
  <Target Name="CodeAltaExcludeNativeSymbols" AfterTargets="ComputeResolvedFilesToPublishList">
    <!-- SkiaSharp and HarfBuzzSharp ship the symbols of their Windows libraries: 100 MB the application never reads. -->
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb' and '%(ResolvedFileToPublish.AssetType)' == 'native'" />
    </ItemGroup>
  </Target>
  <Target Name="CodeAltaExcludeBuildOnlyContractSource" AfterTargets="NeoAstraCollectRpcArtifacts">
    <!-- Keep generated contracts for TS checking/build and runtime JSON metadata, not TS source in the tool. -->
    <ItemGroup>
      <ContentWithTargetPath Remove="$(NeoRpcTypeScriptOutput)" />
    </ItemGroup>
  </Target>
</Project>
