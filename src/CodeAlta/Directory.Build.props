<Project>
  <Import Project="../Directory.Build.props" />
  <PropertyGroup>
    <!-- NeoAstra explicitly collects packaged assets; SDK source globs must not walk frontend outputs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**;frontend/node_modules/**;frontend/dist/**</DefaultItemExcludes>
    <!-- Build-only generated frontend inputs retain the reviewed relative npm/TS paths. -->
    <NeoRpcIntermediateOutputPath>$(MSBuildProjectDirectory)/obj/neoastra</NeoRpcIntermediateOutputPath>
    <NeoAstraFrontendClientStageDirectory>$(MSBuildProjectDirectory)/obj/neoastra/client</NeoAstraFrontendClientStageDirectory>
  </PropertyGroup>
</Project>
