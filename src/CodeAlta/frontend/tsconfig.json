{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "paths": {
      "#neoastra": ["../obj/neoastra/neoastra.ts"],
      "@neoastra/client": ["./node_modules/@neoastra/client/dist/index.d.ts"]
    },
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src"]
}
