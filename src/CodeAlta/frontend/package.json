    "@codemirror/view": "6.43.15",
    "@dagrejs/dagre": "3.1.3",
    "@neoastra/client": "file:../obj/neoastra/client",
    "@observablehq/plot": "0.6.19",
    "@radix-ui/react-dialog": "1.3.1",
    "@xterm/addon-clipboard": "0.3.0-beta.336",
