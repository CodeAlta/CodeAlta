    "@radix-ui/react-dialog": "1.1.23",
    "dompurify": "3.4.14",
    "flexlayout-react": "0.11.0",
    "lucide-react": "0.511.0",
    "markdown-it": "15.0.2",
    "mermaid": "11.17.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "tsx": "4.23.1",
    "type-fest": "4.41.0",
    "typescript": "5.9.3",
    "vite": "8.2.0"
  }
