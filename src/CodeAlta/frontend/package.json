{
  "name": "codealta-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "demo": "vite --mode demo --host 127.0.0.1 --strictPort --open",
