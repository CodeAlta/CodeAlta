<Project Sdk="Microsoft.NET.Sdk">

  <!-- The self-update of altanode and altaserver: the versions of a NuGet feed, the download and its hash, the versions
       side by side under the state root, the pointer, the trial of a new version and its rollback, the launcher that
       hands over to the selected version. It references the protocol and the core only, so that the server, which never
       references the agent runtime, uses it as nodes do (ArchitectureGuardrailTests). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeAlta.Core\CodeAlta.Core.csproj" />
    <ProjectReference Include="..\CodeAlta.Fleet.Protocol\CodeAlta.Fleet.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CodeAlta.Fleet.Update.Tests" />
  </ItemGroup>
</Project>
