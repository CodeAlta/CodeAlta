<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Built-in plugin of CodeAlta that pseudonymizes what confidential sessions send to their providers.</Description>
    <Authors>Alexandre Mutel</Authors>
    <PackageTags>codealta;plugin;privacy;pseudonymization;agentic;ai</PackageTags>
    <PackageProjectUrl>https://github.com/xoofx/CodeAlta</PackageProjectUrl>
    <PackageLicenseExpression>BSD-2-Clause</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeAlta.Plugins.Abstractions\CodeAlta.Plugins.Abstractions.csproj" />
    <ProjectReference Include="..\CodeAlta.Pseudonymization\CodeAlta.Pseudonymization.csproj" />
    <ProjectReference Include="..\CodeAlta.Catalog\CodeAlta.Catalog.csproj" />
    <InternalsVisibleTo Include="CodeAlta.Tests" />
    <InternalsVisibleTo Include="CodeAlta.Desktop.Tests" />
    <InternalsVisibleTo Include="CodeAlta.Pseudonymization.Tests" />
  </ItemGroup>
</Project>
