<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <DefaultItemExcludes>$(DefaultItemExcludes);NativeSmoke/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MSTest" />
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    <ProjectReference Include="../CodeAlta/CodeAlta.csproj" />
    <ProjectReference Include="../CodeAlta.Plugin.Mcp/CodeAlta.Plugin.Mcp.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Resolves the temporary directory of the test process, which macOS places below a symbolic link. -->
    <Compile Include="../CodeAlta.Tests/LinkFreeTempDirectory.cs" Link="LinkFreeTempDirectory.cs" />
  </ItemGroup>
</Project>
