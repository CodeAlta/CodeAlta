<Project Sdk="Microsoft.NET.Sdk">

  <!-- The lowest layer: the safe operations on files that every project shares (a file replaced while others read it, a
       read that never takes a replacement for a missing file, the lock files of the processes of one profile, the lock of a
       path within a process). It references nothing of CodeAlta, so that the self-update and the server use it as the
       agent runtime does. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CodeAlta.Tests" />
  </ItemGroup>
</Project>
