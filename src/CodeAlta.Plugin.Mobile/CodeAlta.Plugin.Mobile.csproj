<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Description>Built-in plugin that serves a mobile view of CodeAlta over a local server, reachable through Tailscale Serve.</Description>
    <Authors>Daniel Cazzulino</Authors>
    <PackageTags>codealta;plugin;mobile</PackageTags>
    <PackageProjectUrl>https://github.com/xoofx/CodeAlta</PackageProjectUrl>
    <PackageLicenseExpression>BSD-2-Clause</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <!-- Kestrel, the same shared framework the desktop MCP server uses. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="QRCoder" />
    <ProjectReference Include="..\CodeAlta.Plugins.Abstractions\CodeAlta.Plugins.Abstractions.csproj" />
    <EmbeddedResource Include="wwwroot\**\*" LogicalName="mobile/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
