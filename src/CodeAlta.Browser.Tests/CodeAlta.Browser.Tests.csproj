<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kestrel serves the pages the browser tests drive, on two origins of the loopback. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\CodeAlta.Browser\CodeAlta.Browser.csproj" />
    <ProjectReference Include="..\CodeAlta.Browser.Cdp.Generator\CodeAlta.Browser.Cdp.Generator.csproj" />
    <ProjectReference Include="..\CodeAlta.Plugin.Browser\CodeAlta.Plugin.Browser.csproj" />
    <!-- The proxy of a sandbox, which the browser of a sandboxed session goes through. -->
    <ProjectReference Include="..\CodeAlta.Sandbox\CodeAlta.Sandbox.csproj" />
  </ItemGroup>

</Project>
