<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Code Mode: the JavaScript engine of scripts, and its parser (Jint 4.17 is built against Acornima 1.7.0, whose 1.x releases keep its API). -->
    <PackageVersion Include="Acornima" Version="1.9.1" />
    <PackageVersion Include="Jint" Version="4.17.0" />
    <PackageVersion Include="Anthropic" Version="13.6.0" />
    <PackageVersion Include="Azure.AI.OpenAI" Version="2.9.0-beta.1" />
    <PackageVersion Include="DiffPlex" Version="1.9.0" />
    <!-- Reads the enterprise managed settings of Copilot accounts; its runtime is pinned in CopilotPinnedRuntime, bumped with it. -->
    <PackageVersion Include="GitHub.Copilot.SDK" Version="1.0.31" />
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="NeoAstra" Version="1.12.0" />
    <PackageVersion Include="MSTest" Version="4.5.2" />
    <PackageVersion Include="Markdig" Version="1.6.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <!-- The Windows service of altanode and altaserver (WindowsServiceHost): ServiceBase, AOT-compatible. -->
    <PackageVersion Include="System.ServiceProcess.ServiceController" Version="10.0.14" />
    <PackageVersion Include="ModelContextProtocol" Version="2.3.1" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.3.1" />
    <PackageVersion Include="ModelContextProtocol.Core" Version="2.3.1" />
    <PackageVersion Include="Nerdbank.MessagePack" Version="1.4.95" />
    <PackageVersion Include="NJsonSchema" Version="11.6.1" />
    <PackageVersion Include="NJsonSchema.CodeGeneration.CSharp" Version="11.6.1" />
    <PackageVersion Include="NuGet.Versioning" Version="7.9.0" />
    <PackageVersion Include="Google.GenAI" Version="1.28.0" />
    <PackageVersion Include="OpenAI" Version="2.15.0" />
    <!-- The export of the traces of CodeAlta, only by CodeAlta.Hosting: the shared libraries use System.Diagnostics alone. -->
    <PackageVersion Include="OpenTelemetry" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="QRCoder" Version="1.8.1" />
    <PackageVersion Include="org.k2fsa.sherpa.onnx" Version="2.0.1" />
    <!-- Search by meaning: the managed binding must not be newer than the ONNX Runtime sherpa-onnx 2.0.1 ships (1.28.2). -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.28.0" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.1" />
    <!-- The sandbox of sessions. 1.0.1 may fall back to changing folder permissions where the native container is
         missing: CodeAlta.Sandbox refuses any request its probe does not serve natively. -->
    <PackageVersion Include="Microsoft.Mxc.Sdk" Version="1.0.1" />
    <PackageVersion Include="SharpYaml" Version="3.17.0" />
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
    <PackageVersion Include="SkiaSharp.NativeAssets.macOS" Version="3.119.4" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Win32" Version="3.119.4" />
    <PackageVersion Include="Tomlyn" Version="2.10.2" />
    <!-- WebDriver BiDi for Firefox in CodeAlta.Browser: 0.x with one main author, so pinned and wrapped behind IBrowserDriver. -->
    <PackageVersion Include="WebDriverBiDi" Version="0.0.63" />
    <PackageVersion Include="XenoAtom.CommandLine.Terminal" Version="2.0.3" />
    <PackageVersion Include="XenoAtom.Logging.Terminal" Version="1.2.0" />
    <PackageVersion Include="XenoAtom.Glob" Version="1.0.1" />
    <!-- CodeAlta Server's sign-in: OpenID Connect discovery and ID token validation (MIT). -->
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
    <!-- The OpenAPI document of CodeAlta Server's REST API. -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <!-- CodeAltaPluginPackageVersions:Start -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
    <PackageVersion Include="XenoAtom.CommandLine" Version="2.0.3" />
    <PackageVersion Include="XenoAtom.Logging" Version="1.2.0" />
    <PackageVersion Include="XenoAtom.Terminal.UI" Version="3.10.0" />
    <PackageVersion Include="XenoAtom.Terminal.UI.Extensions.CodeEditor.TextMateSharp" Version="3.10.0" />
    <PackageVersion Include="XenoAtom.Terminal.UI.Extensions.Markdown" Version="3.10.0" />
    <PackageVersion Include="XenoAtom.Terminal.UI.Extensions.Screenshot" Version="3.10.0" />
    <PackageVersion Include="XenoAtom.Terminal.UI.Graphics" Version="3.10.0" />
    <!-- CodeAltaPluginPackageVersions:End -->
  </ItemGroup>
</Project>
