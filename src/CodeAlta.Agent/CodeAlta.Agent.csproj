<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CodeAlta.Agent.Anthropic" />
    <InternalsVisibleTo Include="CodeAlta.Agent.Copilot" />
    <InternalsVisibleTo Include="CodeAlta.Agent.GoogleGenAI" />
    <InternalsVisibleTo Include="CodeAlta.Agent.Mistral" />
    <InternalsVisibleTo Include="CodeAlta.Agent.OpenAI" />
    <InternalsVisibleTo Include="CodeAlta.Agent.Xai" />
    <InternalsVisibleTo Include="CodeAlta.Catalog" />
    <InternalsVisibleTo Include="CodeAlta.Orchestration" />
    <InternalsVisibleTo Include="CodeAlta.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DiffPlex" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <!-- Images a tool gives the model are checked and resized with Skia: its native library is named for
         every platform CodeAlta ships on instead of relying on what another package brings. -->
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" />
    <PackageReference Include="XenoAtom.Glob" />
    <PackageReference Include="XenoAtom.Logging" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Data\models_dev_db.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
