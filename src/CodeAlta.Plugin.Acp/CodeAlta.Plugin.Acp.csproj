<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Built-in Agent Client Protocol plugin for CodeAlta: agents of the ACP registry as model providers.</Description>
    <Authors>Alexandre Mutel</Authors>
    <PackageTags>codealta;plugin;acp;agent-client-protocol;agentic;ai</PackageTags>
    <PackageProjectUrl>https://github.com/xoofx/CodeAlta</PackageProjectUrl>
    <PackageLicenseExpression>BSD-2-Clause</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeAlta.Acp\CodeAlta.Acp.csproj" />
    <ProjectReference Include="..\CodeAlta.Plugins.Abstractions\CodeAlta.Plugins.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CodeAlta.Tests" />
    <InternalsVisibleTo Include="CodeAlta.Desktop.Tests" />
  </ItemGroup>
</Project>
