<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Extensions.Hosting comes from the shared framework of ASP.NET Core: a test project that runs on
         that framework itself (CodeAlta.Desktop.Tests) does not copy the package next to this server, which runs
         as a process of its own and must then name the framework in its runtimeconfig.json. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

</Project>
