<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The automation engine: definitions, schedules, triggers, runs and their state, for any host (CodeAlta Desktop,
    CodeAlta Node). It knows no window and no network.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The hosts that run the engine, and their tests. -->
    <InternalsVisibleTo Include="alta" />
    <InternalsVisibleTo Include="altanode" />
    <InternalsVisibleTo Include="CodeAlta.Desktop.Tests" />
    <InternalsVisibleTo Include="CodeAlta.Node.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeAlta.Orchestration\CodeAlta.Orchestration.csproj" />
    <!-- The repositories the issue and pull request triggers watch. -->
    <ProjectReference Include="..\CodeAlta.Plugin.Git\CodeAlta.Plugin.Git.csproj" />
  </ItemGroup>

</Project>
